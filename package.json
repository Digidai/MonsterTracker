{
  "name": "monstertracker",
  "version": "0.1.0",
  "description": "Cloudflare-native distributed website monitoring with Workers Placement Hints.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "client:dev": "vite --host 127.0.0.1",
    "dev": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply monstertracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply monstertracker --remote",
    "generate:probes": "node scripts/generate-probe-configs.mjs",
    "list:placement-regions": "node scripts/list-supported-regions.mjs",
    "types": "wrangler types ./worker-configuration.d.ts",
    "check": "tsc --noEmit && vitest run && npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "^8.1.5",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "dependencies": {
    "@heroui-pro/react": "1.0.0-beta.9",
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/interactions": "3.28.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "motion": "13.3.0",
    "react": "^19.2.8",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.12.4",
    "react-stately": "3.50.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  }
}
