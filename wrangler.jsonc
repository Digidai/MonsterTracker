{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monstertracker-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*", "/health"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ROLE": "control",
    "APP_NAME": "MonsterTracker",
    "REGION_PACK": "core",
    "DEFAULT_DAILY_PROBE_BUDGET": "100",
    "DEFAULT_RETENTION_DAYS": "30",
    "PROBE_BATCH_SIZE": "5",
    "RESULT_QUEUE_BATCH_SIZE": "10",
    "PROBE_CONCURRENCY": "6",
    "DISPATCH_CONCURRENCY": "6",
    "MAX_PROBE_RESPONSE_BYTES": "512000",
    "MAX_DISPATCH_TIMEOUT_MS": "130000",
    "MAX_DAILY_PROBES": "10000",
    "MAX_MONITOR_DAILY_BUDGET": "10000",
    "PROBE_WORKER_HOST_SUFFIX": ".genedai.workers.dev",
    "ALLOW_LOCAL_PROBES": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monstertracker",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "monstertracker-archive"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "monstertracker_results"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RESULTS_QUEUE",
        "queue": "monstertracker-results"
      },
      {
        "binding": "RESULTS_DLQ",
        "queue": "monstertracker-results-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "monstertracker-results",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "dead_letter_queue": "monstertracker-results-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
